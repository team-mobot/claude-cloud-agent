{
  "family": "test-tickets-uat",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "taskRoleArn": "arn:aws:iam::678954237808:role/test-tickets-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::678954237808:role/test-tickets-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "test-tickets",
      "image": "678954237808.dkr.ecr.us-east-1.amazonaws.com/test-tickets-uat:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "VPC_ID",
          "value": "vpc-0fde49947ce39aec4"
        },
        {
          "name": "UAT_DOMAIN_SUFFIX",
          "value": "uat.teammobot.dev"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "MOBOT_BASE_URL",
          "value": "https://app.teammobot.dev"
        },
        {
          "name": "ALB_LISTENER_ARN",
          "value": "arn:aws:elasticloadbalancing:us-east-1:678954237808:listener/app/test-tickets-uat-alb/7e47b6b368ee29e1/9b650b437fde8e6f"
        },
        {
          "name": "SESSIONS_TABLE",
          "value": "claude-cloud-agent-sessions"
        },
        {
          "name": "USE_NATIVE_GIT",
          "value": "true"
        },
        {
          "name": "TEST_PLANS_GIT_REPO_PATH",
          "value": "/data/repos/ai_driver_test_plans"
        },
        {
          "name": "CUSTOMER_DOCS_GIT_REPO_PATH",
          "value": "/data/repos/customer-docs"
        },
        {
          "name": "TEST_PLANS_GIT_REMOTE_SYNC_ENABLED",
          "value": "false"
        },
        {
          "name": "CUSTOMER_DOCS_GIT_REMOTE_SYNC_ENABLED",
          "value": "false"
        },
        {
          "name": "CUSTOMER_DOCS_MEDIA_LOCAL_ROOT_PATH",
          "value": "/data/customer-docs-media"
        },
        {
          "name": "VALKEY_URL",
          "value": "rediss://master.mobot-agents-staging-valkey.nmj4ut.use1.cache.amazonaws.com:6379"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:JWT_SECRET::"
        },
        {
          "name": "MOBOT_JWS_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:MOBOT_JWS_SECRET::"
        },
        {
          "name": "STAGING_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:DATABASE_URL::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:DATABASE_URL::"
        },
        {
          "name": "ANALYTICS_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:ANALYTICS_DATABASE_URL::"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:mobot-agents/staging-5WNH6Y:GOOGLE_CLIENT_ID::"
        },
        {
          "name": "GITHUB_APP_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:claude-dev/github-app-704JPc:app_id::"
        },
        {
          "name": "GITHUB_APP_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:claude-dev/github-app-704JPc:private_key::"
        },
        {
          "name": "GITHUB_APP_INSTALLATION_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:678954237808:secret:claude-dev/github-app-704JPc:default_installation_id::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/test-tickets-uat",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "uat"
        }
      }
    }
  ]
}
